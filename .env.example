# Research Hub — biến môi trường
# Sao chép thành .env.local rồi điền giá trị thật. Không commit file .env.local.

# --- Bắt buộc ngay từ Giai đoạn 0 (env.ts fail-fast nếu thiếu) ---
# Chuỗi kết nối Neon Postgres. Dùng pooled connection string cho app.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.aws-ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Khoá Ollama Cloud: model + web_search + web_fetch + embedding
OLLAMA_API_KEY=
# Endpoint Ollama. Đặt http://127.0.0.1:11434 để nhúng bằng model chạy ở máy (không cần khoá);
# đặt https://ollama.com khi muốn gọi cloud. Bỏ trống cũng mặc định về địa chỉ cục bộ.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Số chiều vector nhúng, phải khớp cột chunks.embedding (vector(1024)). Chỉ đổi khi thay model
# nhúng; bỏ trống hoặc ghi sai thì dùng mặc định 1024.
EMBED_DIM=1024
# Token Cloudflare cho Workers AI (dự phòng khi hết hạn mức Ollama).
# Tạo ở dash.cloudflare.com > My Profile > API Tokens > Create Token > template "Workers AI".
# Cần thêm Account ID vì REST API của Workers AI nằm dưới /accounts/<id>/ai/run/.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Neon Managed Better Auth: URL auth và cookie secret (>= 32 ký tự)
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
# Bí mật gọi route cron; Vercel Cron sẽ gửi kèm header Authorization: Bearer <giá trị này>
CRON_SECRET=

# --- Bật ở Giai đoạn 6 (để trống vẫn khởi động được) ---
# Incoming Webhook của Slack cho bản tin hằng ngày
SLACK_WEBHOOK_URL=
# API key Resend gói Free (100 email/ngày) cho bản tin hằng ngày
RESEND_API_KEY=
# API key SSI FastConnect cho dữ liệu chứng khoán VN
SSI_API_KEY=

# --- Object Storage của Neon ---
# Bốn biến AWS_* do `neon link` tự đẩy vào .env.local, không cần điền tay.
# Tên bucket khai trong neon.ts; ở đây giữ để hàm ký URL biết gọi vào bucket nào.
OBJECT_STORAGE_BUCKET=research-hub-media
# AWS_ENDPOINT_URL_S3, AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY do `neon link` cấp
